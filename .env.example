MONGO_INITDB_ROOT_USERNAME=zerovault
MONGO_INITDB_ROOT_PASSWORD=change-this-local-mongo-password
MONGO_URI=mongodb://zerovault:change-this-local-mongo-password@localhost:27018/zerovault?authSource=admin
VALKEY_URL=redis://localhost:6379
SESSION_JWE_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
VAULT_KEK_PUBLIC_KEY_BASE64=replace-with-a-base64-encoded-RSA-public-PEM
VAULT_KEK_PRIVATE_KEY_BASE64=replace-with-a-base64-encoded-RSA-private-PEM
VAULT_KEK_KEY_ID=local-rsa-oaep-kek-v1
VAULT_MAX_LEASE_TTL_SECONDS=3600
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4000
WEBAUTHN_RP_NAME=ZeroVault Nexus Local
WEBAUTHN_CHALLENGE_TTL_MS=300000
SESSION_TTL_SECONDS=900
SPIFFE_TRUST_DOMAIN=zerovault.local
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OIDC_ISSUER=https://github.com
GITHUB_OIDC_AUDIENCE=zerovault-nexus
GITHUB_OIDC_JWKS_URL=https://github.com/.well-known/jwks.json
